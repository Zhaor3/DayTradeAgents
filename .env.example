# ── LLM Provider ──
# Options: "openai" or "anthropic"
LLM_PROVIDER=openai

# OpenAI API Key (get from https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Anthropic API Key (get from https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# Models - two tiers for cost optimization
# Deep: used for technical analysis, debate, and final decision
# Quick: used for news, fundamentals, formatting
LLM_MODEL_QUICK=gpt-5-mini
LLM_MODEL_DEEP=gpt-5.2

# ── Telegram Bot ──
# 1. Message @BotFather on Telegram -> /newbot -> copy the token
TELEGRAM_BOT_TOKEN=

# 2. Message @userinfobot on Telegram to get your numeric chat ID
TELEGRAM_CHAT_ID=
